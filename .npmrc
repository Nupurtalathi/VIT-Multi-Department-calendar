# pdfjs-dist lists `canvas` as an optional dependency, used only for
# rendering PDFs to a bitmap in Node. This app only extracts text
# (page.getTextContent()), never renders, so canvas is unnecessary — and
# its native-build toolchain pulls in a vulnerable tar/node-pre-gyp chain.
# Skipping optional deps avoids that entirely with no loss of functionality.
omit=optional
